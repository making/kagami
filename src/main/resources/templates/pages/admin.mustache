{{>layouts/head}}
{{>fragments/warn-banner}}
<div class="page">
  <div class="section-line registry-label">
    <a href="/" class="registry-label">&larr; Repositories</a>
    <span>/ Administration</span>
  </div>

  <header class="page-head">
    <div class="page-head-title">
      <span class="page-head-mark">GC</span>
      <h1>Cache <span class="hero-title-gradient">Administration</span></h1>
    </div>
    <p class="page-head-sub">Preview and collect metadata-only cache directories</p>
  </header>

  <div class="panel" id="gc-panel">
    <div class="panel-head">
      <h2 class="registry-label panel-head-label">Repository Garbage Collection</h2>
      <span class="registry-label panel-head-meta">artifacts:admin</span>
    </div>
    <div class="section-head">
      <p>Only directories containing exactly maven-metadata.xml and maven-metadata.xml.sha1 are eligible.</p>
    </div>
    <form id="gc-form" action="/app/admin/gc" method="post" hx-post="/app/admin/gc" hx-target="#gc-result" hx-swap="innerHTML">
      {{#_csrf}}<input type="hidden" name="_csrf" value="{{_csrf.token}}"/>{{/_csrf}}
      <div class="gc-form">
        <div class="gc-form-fields">
          <div class="form-group">
            <label class="form-label" for="gc-repository">Repository</label>
            <select class="form-input" id="gc-repository" name="repositoryId" required>
              {{#repositories}}<option value="{{id}}">{{id}}{{#isPrivate}} (private){{/isPrivate}}</option>{{/repositories}}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="gc-older-than">Older than (hours)</label>
            <input class="form-input" id="gc-older-than" name="olderThanHours" type="number" min="1" value="{{defaultOlderThanHours}}" required/>
          </div>
        </div>
        {{^hasRepositories}}
        <div class="alert" role="alert">No repositories are configured.</div>
        {{/hasRepositories}}
        <div class="page-actions gc-actions">
          <button type="button" class="button button-secondary button-loading"
                  hx-get="/app/admin/gc/preview" hx-include="closest form"
                  hx-target="#gc-result" hx-swap="innerHTML"
                  {{^hasRepositories}}disabled{{/hasRepositories}}>Preview</button>
          <button type="submit" class="button button-loading"
                  hx-confirm="Collect eligible metadata-only directories? This operation cannot be undone."
                  {{^hasRepositories}}disabled{{/hasRepositories}}>Run Garbage Collection</button>
        </div>
      </div>
    </form>
    <div id="gc-result" class="gc-result">
      {{>fragments/admin-gc-result}}
    </div>
  </div>

  {{>layouts/footer}}
</div>
{{>layouts/tail}}
