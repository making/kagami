{{>layouts/head}}
{{>fragments/warn-banner}}
<div class="page">
  <div class="section-line registry-label">
    <a href="/" class="registry-label">&larr; Repositories</a>
    <span>/ Administration</span>
  </div>

  <header class="page-head">
    <div class="page-head-title">
      <span class="page-head-mark">GC</span>
      <h1>Cache <span class="hero-title-gradient">Administration</span></h1>
    </div>
    <p class="page-head-sub">Preview and collect leftover cache directories</p>
  </header>

  <div class="panel" id="repository-settings-panel">
    <div class="panel-head">
      <h2 class="registry-label panel-head-label">Repository Settings</h2>
      <span class="registry-label panel-head-meta">format / upstream</span>
    </div>
    <table class="registry-table">
      <thead>
        <tr>
          <th class="registry-label text-left">Repository</th>
          <th class="registry-label">Format</th>
          <th class="registry-label">Format Settings</th>
          <th class="registry-label">Retention</th>
        </tr>
      </thead>
      <tbody>
        {{#repositories}}
        <tr class="registry-row-hover">
          <td>
            <div class="row-title">{{id}}{{#isPrivate}}<span class="registry-label badge-private">Private</span>{{/isPrivate}}</div>
            <div class="row-url">{{url}}</div>
          </td>
          <td><span class="registry-label badge-format">{{formatLabel}}</span></td>
          <td><span class="row-value">{{formatSetting}}</span></td>
          <td><span class="row-value">{{retentionSetting}}</span></td>
        </tr>
        {{/repositories}}
      </tbody>
    </table>
    {{^hasRepositories}}
    <div class="alert" role="alert">No repositories are configured.</div>
    {{/hasRepositories}}
  </div>

  <div class="panel" id="gc-panel">
    <div class="panel-head">
      <h2 class="registry-label panel-head-label">Repository Garbage Collection</h2>
      <span class="registry-label panel-head-meta">artifacts:admin</span>
    </div>
    <div class="section-head">
      <p>Directories whose files are all cache bookkeeping files (maven-metadata*.xml and their checksums, resolver-status.properties, _remote.repositories, *.lastUpdated), and empty directories, are eligible. The rules do not depend on the repository format.</p>
    </div>
    <form id="gc-form" action="/app/admin/gc" method="post" hx-post="/app/admin/gc" hx-indicator="#gc-run-button" hx-target="#gc-result" hx-swap="innerHTML">
      {{#_csrf}}<input type="hidden" name="_csrf" value="{{_csrf.token}}"/>{{/_csrf}}
      <div class="gc-form">
        <div class="gc-form-fields">
          <div class="form-group">
            <label class="form-label" for="gc-repository">Repository</label>
            <select class="form-input" id="gc-repository" name="repositoryId" required>
              {{#repositories}}<option value="{{id}}">{{id}}{{#isPrivate}} (private){{/isPrivate}}</option>{{/repositories}}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="gc-older-than">Older than (hours)</label>
            <input class="form-input" id="gc-older-than" name="olderThanHours" type="number" min="1" value="{{defaultOlderThanHours}}" required/>
          </div>
        </div>
        {{^hasRepositories}}
        <div class="alert" role="alert">No repositories are configured.</div>
        {{/hasRepositories}}
        <div class="page-actions gc-actions">
          <button type="button" class="button button-secondary button-loading"
                  hx-get="/app/admin/gc/preview" hx-include="closest form"
                  hx-target="#gc-result" hx-swap="innerHTML"
                  {{^hasRepositories}}disabled{{/hasRepositories}}>Preview</button>
          <button type="submit" id="gc-run-button" class="button button-primary button-loading"
                  hx-confirm="Collect eligible leftover directories? This operation cannot be undone."
                  {{^hasRepositories}}disabled{{/hasRepositories}}>Run Garbage Collection</button>
        </div>
      </div>
    </form>
    <div id="gc-result" class="gc-result">
      {{>fragments/admin-gc-result}}
    </div>
  </div>

  <div class="panel" id="retention-panel">
    <div class="panel-head">
      <h2 class="registry-label panel-head-label">Artifact Retention</h2>
      <span class="registry-label panel-head-meta">scheduled sweep</span>
    </div>
    <div class="section-head">
      <p>Artifacts are evicted together with their checksums and sigstore bundles, oldest first, when they exceed the repository's <code>retention.max-age</code> or <code>retention.max-size</code> limit. A repository without a limit is kept as it is. The scheduled sweep runs in the background; use the button to apply the policy now.</p>
    </div>
    <form id="retention-form" action="/app/admin/retention" method="post" hx-post="/app/admin/retention" hx-indicator="#retention-run-button" hx-target="#retention-result" hx-swap="innerHTML">
      {{#_csrf}}<input type="hidden" name="_csrf" value="{{_csrf.token}}"/>{{/_csrf}}
      <div class="gc-form">
        <div class="gc-form-fields">
          <div class="form-group">
            <label class="form-label" for="retention-repository">Repository</label>
            <select class="form-input" id="retention-repository" name="repositoryId" required>
              {{#repositories}}<option value="{{id}}">{{id}}{{#isPrivate}} (private){{/isPrivate}}{{^retentionEnabled}} - keep forever{{/retentionEnabled}}</option>{{/repositories}}
            </select>
          </div>
        </div>
        {{^hasRepositories}}
        <div class="alert" role="alert">No repositories are configured.</div>
        {{/hasRepositories}}
        <div class="page-actions gc-actions">
          <button type="submit" id="retention-run-button" class="button button-primary button-loading"
                  hx-confirm="Apply the retention policy now? Evicted artifacts are refetched from the upstream on the next request."
                  {{^hasRepositories}}disabled{{/hasRepositories}}>Apply Retention Policy</button>
        </div>
      </div>
    </form>
    <div id="retention-result" class="gc-result">
      {{>fragments/admin-retention-result}}
    </div>
  </div>

  {{>layouts/footer}}
</div>
{{>layouts/tail}}
