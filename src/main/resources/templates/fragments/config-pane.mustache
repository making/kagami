<div class="code-head">
  <h4 class="registry-label" style="font-weight: 600;">{{title}}</h4>
  <button type="button" class="registry-label copy-button" data-copy="{{content}}">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
    <span data-copy-label>Copy</span>
  </button>
</div>
<div class="code-note">Add this configuration to your <code>{{filename}}</code>:</div>
<pre class="config-code"><code>{{content}}</code></pre>
